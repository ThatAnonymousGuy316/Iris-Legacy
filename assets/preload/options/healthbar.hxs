var customBG;
var customBar;
var scrool;
var scrool2;
var crackMe;
var scrollOffset = 0.0;
var scrollSpeed = 60.0; // Adjust scrolling speed here

function onCreatePost() {
    if (this.healthBar != null) this.healthBar.visible = false;
    if (this.healthBarBG != null) this.healthBarBG.visible = false;
    if (this.iconP2 != null) this.iconP2.visible = false;

    customBG = new FlxSprite(25, 350);
    customBG.loadGraphic(Paths.image('health/base'));
    customBG.cameras = [this.camHUD];

    customBar = new FlxSprite(25, 350);
    customBar.loadGraphic(Paths.image('health/bar'));
    customBar.cameras = [this.camHUD];


    scrool = new FlxSprite(customBar.x, customBar.y);
    scrool.loadGraphic(Paths.image('health/scrool'));
    scrool.cameras = [this.camHUD];


    scrool2 = new FlxSprite(customBar.x, customBar.y);
    scrool2.loadGraphic(Paths.image('health/scrool'));
    scrool2.cameras = [this.camHUD];

    crackMe = new FlxSprite(customBar.x, customBar.y);
    crackMe.loadGraphic(Paths.image('health/health_crack'));
    crackMe.cameras = [this.camHUD];
    crackMe.visible = false;

    if (this.iconP1 != null) {
        this.iconP1.flipX = true;
    }

    add(customBG);
    add(crackMe);
    add(scrool);
    add(scrool2);
    add(customBar);
}

function onUpdatePost(elapsed) {
    if (customBar != null && scrool != null && scrool2 != null) {
        var barHeight = Std.int(customBar.height);
        var barWidth = Std.int(customBar.width);


        if (this.boyfriend != null && this.boyfriend.healthColorArray != null && customBG != null) {
            var bfC = this.boyfriend.healthColorArray;
            customBG.color = FlxColor.fromRGB(bfC[0], bfC[1], bfC[2]);
        }


        scrollOffset += elapsed * scrollSpeed;

        var textureHeight = Std.int(scrool.frameHeight);
        if (textureHeight > 0) {

            var shift = Std.int(scrollOffset) % textureHeight;
            if (shift < 0) shift += textureHeight;


            scrool.visible = true;
            scrool.x = customBar.x;
            scrool.y = customBar.y - shift;
            scrool.clipRect = new FlxRect(0, shift, scrool.frameWidth, textureHeight - shift);


            scrool2.visible = (shift > 0);
            scrool2.x = customBar.x;
            scrool2.y = customBar.y + (textureHeight - shift);
            scrool2.clipRect = new FlxRect(0, 0, scrool2.frameWidth, shift);
        }


        if (crackMe != null) {
            crackMe.visible = (this.health < 0.4);
        }


        if (this.iconP1 != null) {
            this.iconP1.x = customBar.x + (barWidth / 2) - (this.iconP1.width / 2);
            this.iconP1.y = customBar.y - this.iconP1.height + 15;
        }
    }
}